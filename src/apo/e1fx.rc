// e1fx.rc - version resource of e1fx.dll
#include <winver.h>

#define E1FX_VER_BIN  1,0,0,0
#define E1FX_VER_STR  "1.0.0.0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    E1FX_VER_BIN
 PRODUCTVERSION E1FX_VER_BIN
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "E1 Studio"
            VALUE "FileDescription",  "E1 Studio audio effects (APO)"
            VALUE "FileVersion",      E1FX_VER_STR
            VALUE "InternalName",     "e1fx"
            VALUE "LegalCopyright",   "Copyright (c) 2026 E1 Studio contributors"
            VALUE "OriginalFilename", "e1fx.dll"
            VALUE "ProductName",      "E1 Studio"
            VALUE "ProductVersion",   E1FX_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
